{
  "name": "youtube-playlist-downloader",
  "version": "1.0.0",
  "description": "Electron app to download YouTube playlists (video or audio) using yt-dlp",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.example.ytplaylistdownloader",
    "productName": "YouTube Playlist Downloader",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "youtube-dl-exec": "^3.0.6"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "allowScripts": {
    "electron@30.5.1": true,
    "youtube-dl-exec@3.1.12": true,
    "ffmpeg-static@5.3.0": true
  }
}
